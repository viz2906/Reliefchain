# ReliefChain environment - copy to .env.local and adjust if needed.
# The defaults match docker-compose.yml, so `cp .env.example .env.local` is enough.

DATABASE_URL=postgresql://relief_admin:relief_secret_password@localhost:5432/reliefchain_db
MONGODB_URI=mongodb://localhost:27017/reliefchain_logs

# Any long random string. Required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
